# Copy this file to secrets.yaml (kept out of git via .gitignore) and fill in
# your own values. Never commit secrets.yaml itself.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

api_encryption_key: "generate-with: esphome secrets or openssl rand -base64 32"
ota_password: "choose-a-strong-password"

fan_static_ip: "192.168.1.100"
network_gateway: "192.168.1.1"

# Raw RF pulse-timing codes captured from the original remote (see
# esphome/rf-capture.yaml for how these were obtained). Each is a
# microsecond timing array, e.g. [287, -441, 599, -774, ...]
rf_code_fan_low: [0]
rf_code_fan_med: [0]
rf_code_fan_high: [0]
rf_code_fan_off: [0]
rf_code_light_toggle: [0]
